# ==============================================================================
# 12. MONITORING & ALARMS
# ==============================================================================
# All alarms are gated on var.enable_monitoring. Notifications go to
# var.alarm_sns_topic_arn when set; the system status-check alarm additionally
# auto-recovers the instance (the availability story for this single-instance
# design).

locals {
  sns_alarm_actions = var.alarm_sns_topic_arn != null ? [var.alarm_sns_topic_arn] : []

  # Region derived from the instance's AZ (e.g. us-east-1a -> us-east-1);
  # avoids the aws_region data source, whose region-name attribute differs
  # between provider v5 (name) and v6 (region, with name deprecated).
  region = substr(aws_instance.nexus_server.availability_zone, 0, length(aws_instance.nexus_server.availability_zone) - 1)
}

# System status check (AWS-side failure: host hardware, network) — auto-recover
# migrates the instance to healthy hardware, preserving instance ID, private IP,
# and EBS attachments.
resource "aws_cloudwatch_metric_alarm" "system_status_check" {
  count               = var.enable_monitoring ? 1 : 0
  alarm_name          = "${var.name_prefix}-system-status-check-failed"
  alarm_description   = "EC2 system status check failed on the Nexus instance; auto-recovering"
  namespace           = "AWS/EC2"
  metric_name         = "StatusCheckFailed_System"
  statistic           = "Maximum"
  period              = 60
  evaluation_periods  = 2
  comparison_operator = "GreaterThanOrEqualToThreshold"
  threshold           = 1

  dimensions = {
    InstanceId = aws_instance.nexus_server.id
  }

  alarm_actions = concat(
    ["arn:aws:automate:${local.region}:ec2:recover"],
    local.sns_alarm_actions
  )
  ok_actions = local.sns_alarm_actions

  tags = merge(local.base_tags, {
    Name = "${var.name_prefix}-system-status-check-failed"
  })
}

# Instance status check (OS-side failure: kernel panic, exhausted memory).
# Not auto-actionable — notify only.
resource "aws_cloudwatch_metric_alarm" "instance_status_check" {
  count               = var.enable_monitoring ? 1 : 0
  alarm_name          = "${var.name_prefix}-instance-status-check-failed"
  alarm_description   = "EC2 instance status check failed on the Nexus instance"
  namespace           = "AWS/EC2"
  metric_name         = "StatusCheckFailed_Instance"
  statistic           = "Maximum"
  period              = 60
  evaluation_periods  = 3
  comparison_operator = "GreaterThanOrEqualToThreshold"
  threshold           = 1

  dimensions = {
    InstanceId = aws_instance.nexus_server.id
  }

  alarm_actions = local.sns_alarm_actions
  ok_actions    = local.sns_alarm_actions

  tags = merge(local.base_tags, {
    Name = "${var.name_prefix}-instance-status-check-failed"
  })
}

resource "aws_cloudwatch_metric_alarm" "core_tg_unhealthy" {
  count               = var.enable_monitoring ? 1 : 0
  alarm_name          = "${var.name_prefix}-core-tg-unhealthy"
  alarm_description   = "Nexus UI target (8081) is unhealthy behind the ALB"
  namespace           = "AWS/ApplicationELB"
  metric_name         = "UnHealthyHostCount"
  statistic           = "Maximum"
  period              = 60
  evaluation_periods  = 5
  comparison_operator = "GreaterThanOrEqualToThreshold"
  threshold           = 1

  dimensions = {
    TargetGroup  = aws_lb_target_group.nexus_core_tg.arn_suffix
    LoadBalancer = aws_lb.nexus_alb.arn_suffix
  }

  alarm_actions = local.sns_alarm_actions
  ok_actions    = local.sns_alarm_actions

  tags = merge(local.base_tags, {
    Name = "${var.name_prefix}-core-tg-unhealthy"
  })
}

# No per-port alarms for the Docker block: those target groups health-check
# the Nexus core port (see 05_alb.tf), so their health mirrors the core target
# group, which already has the alarm above.

# 5xx generated by the ALB itself (no healthy target, timeouts) — distinct from
# application 5xx returned by Nexus.
resource "aws_cloudwatch_metric_alarm" "alb_5xx" {
  count               = var.enable_monitoring ? 1 : 0
  alarm_name          = "${var.name_prefix}-alb-5xx"
  alarm_description   = "Elevated ALB-generated 5xx responses for Nexus"
  namespace           = "AWS/ApplicationELB"
  metric_name         = "HTTPCode_ELB_5XX_Count"
  statistic           = "Sum"
  period              = 300
  evaluation_periods  = 1
  comparison_operator = "GreaterThanOrEqualToThreshold"
  threshold           = var.alb_5xx_alarm_threshold
  treat_missing_data  = "notBreaching"

  dimensions = {
    LoadBalancer = aws_lb.nexus_alb.arn_suffix
  }

  alarm_actions = local.sns_alarm_actions
  ok_actions    = local.sns_alarm_actions

  tags = merge(local.base_tags, {
    Name = "${var.name_prefix}-alb-5xx"
  })
}

# Disk usage on the data volume, published by the CloudWatch agent installed in
# user-data (01_ec2_instance.tf). The agent aggregates to InstanceId+path
# dimensions so the alarm doesn't depend on the NVMe device name.
resource "aws_cloudwatch_metric_alarm" "data_volume_disk_usage" {
  count               = var.enable_monitoring ? 1 : 0
  alarm_name          = "${var.name_prefix}-data-volume-disk-usage"
  alarm_description   = "Nexus data volume (/data/nexus) is over ${var.data_volume_disk_alarm_threshold}% full"
  namespace           = "CWAgent"
  metric_name         = "disk_used_percent"
  statistic           = "Maximum"
  period              = 300
  evaluation_periods  = 1
  comparison_operator = "GreaterThanOrEqualToThreshold"
  threshold           = var.data_volume_disk_alarm_threshold

  dimensions = {
    InstanceId = aws_instance.nexus_server.id
    path       = "/data/nexus"
  }

  alarm_actions = local.sns_alarm_actions
  ok_actions    = local.sns_alarm_actions

  tags = merge(local.base_tags, {
    Name = "${var.name_prefix}-data-volume-disk-usage"
  })
}

# Lets the CloudWatch agent publish metrics; only needed (and only attached)
# when monitoring is enabled.
resource "aws_iam_role_policy_attachment" "cw_agent" {
  count      = var.enable_monitoring ? 1 : 0
  role       = aws_iam_role.nexus_role.name
  policy_arn = "arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy"
}
